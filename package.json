{
  "name": "claude-code-toast-notifier",
  "displayName": "Claude Code Toast Notifier",
  "description": "A Windows popup (toast) notification for Claude Code that reliably appears, without needing the app registration Windows normally requires for toast notifications. Unofficial, not affiliated with Anthropic.",
  "version": "0.1.0",
  "publisher": "lukalesko",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "notification",
    "toast",
    "popup",
    "alert",
    "hooks"
  ],
  "galleryBanner": {
    "color": "#4F46E5",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeNotifier.setup",
        "title": "Claude Notifier: Enable Notifications"
      },
      {
        "command": "claudeNotifier.disable",
        "title": "Claude Notifier: Disable Notifications"
      },
      {
        "command": "claudeNotifier.testNotification",
        "title": "Claude Notifier: Test Notification"
      }
    ],
    "configuration": {
      "title": "Claude Code Notifier",
      "properties": {
        "claudeNotifier.toastEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a Windows popup notification (toast, bottom-right of the screen) when Claude finishes or needs input."
        },
        "claudeNotifier.notifyOnIdle": {
          "type": "boolean",
          "default": true,
          "description": "Also show a notification when Claude has been idle ~60s waiting for your input (not just permission prompts)."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "vscode:prepublish": "npm run clean && tsc -p ./",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
